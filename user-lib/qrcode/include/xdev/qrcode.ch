#ifndef QRCODE_CH
#define QRCODE_CH

/* QrEncode() error correction levels: share of the code that may be damaged */
#define QR_ECC_LOW        0  /* about 7% */
#define QR_ECC_MEDIUM     1  /* about 15% (default) */
#define QR_ECC_QUARTILE   2  /* about 25% */
#define QR_ECC_HIGH       3  /* about 30% */

#endif
