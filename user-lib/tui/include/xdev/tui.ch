#ifndef TUI_CH
#define TUI_CH

/* Official xDev colours (0xRRGGBB) */
#define COLOR_BLUE        0x264D73
#define COLOR_WINE        0x73264D
#define COLOR_OLIVE       0x4D7326
#define COLOR_INDIGO      0x262773
#define COLOR_TEAL        0x267373
#define COLOR_BROWN       0x734C26

/* Shades used by the xDev web site */
#define COLOR_BLUE_DARK   0x1A3550
#define COLOR_BLUE_TINT1  0xD3DBE3
#define COLOR_BLUE_TINT2  0xE9EDF1
#define COLOR_PAPER       0xF2F2F2
#define COLOR_TEXT        0x111111

/* Text alignment */
#define TUI_LEFT          0
#define TUI_CENTER        1
#define TUI_RIGHT         2

#endif /* TUI_CH */
