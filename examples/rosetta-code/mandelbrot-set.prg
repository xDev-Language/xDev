PROCEDURE Main()

   LOCAL cChars := " .:-=+*#%@"
   LOCAL nRow   AS INT
   LOCAL nCol   AS INT
   LOCAL nIter  AS INT
   LOCAL x0     AS FLOAT
   LOCAL y0     AS FLOAT
   LOCAL x      AS FLOAT
   LOCAL y      AS FLOAT
   LOCAL xNew   AS FLOAT
   LOCAL cLine  AS STRING

   FOR nRow := 0 TO 30
      cLine := ""
      y0 := -1.2 + nRow * 2.4 / 30
      FOR nCol := 0 TO 78
         x0 := -2.1 + nCol * 3.0 / 78
         x := 0
         y := 0
         nIter := 0
         DO WHILE x * x + y * y <= 4 .AND. nIter < 100
            xNew := x * x - y * y + x0
            y    := 2 * x * y + y0
            x    := xNew
            nIter++
         ENDDO
         cLine += SubStr( cChars, IIF( nIter == 100, 10, nIter % 9 + 1 ), 1 )
      NEXT
      QOut( cLine )
   NEXT

   RETURN
