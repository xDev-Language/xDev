#ifndef BOX_CH
#define BOX_CH

/* frames for @ ... BOX and DispBox(): corners and sides clockwise from the top left, in UTF-8 */
#define B_SINGLE        "┌─┐│┘─└│"
#define B_DOUBLE        "╔═╗║╝═╚║"
#define B_SINGLE_DOUBLE "╓─╖║╜─╙║"
#define B_DOUBLE_SINGLE "╒═╕│╛═╘│"

#endif


